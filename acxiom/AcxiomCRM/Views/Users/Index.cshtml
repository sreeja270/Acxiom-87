@model AcxiomCRM.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">User Administration</h2>
        <p class="text-muted small mb-0">Manage system users, role allocations, account active states, and lockout resolutions.</p>
    </div>
    <a asp-action="Create" class="btn btn-crm-primary">
        <i class="bi bi-person-plus me-1"></i> Add New User
    </a>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search name, email, department..." />
            </div>
        </div>

        <div class="col-md-4">
            <select name="roleFilter" asp-items="Model.RolesList" class="form-select">
                <option value="">All Security Roles</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Users.Any())
        {
            <div class="table-responsive">
                <table class="table crm-table align-middle">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th>Email Address</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Lockout Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light border text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @user.FullName.FirstOrDefault()
                                        </div>
                                        <span class="fw-semibold text-white">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="small">@user.Email</td>
                                <td class="small text-muted">@(user.Department ?? "—")</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger" : user.Role == "Manager" ? "bg-warning text-white" : "bg-primary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(user.IsActive ? "badge-soft-success" : "badge-soft-danger")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsLockedOut)
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-danger">Locked</span>
                                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1 small" title="Unlock account immediately">
                                                    Unlock
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-success small">Normal</span>
                                    }
                                </td>
                                <td class="small text-muted">@user.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-action" data-bs-toggle="tooltip" title="Edit Profile & Role">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-action text-warning" data-bs-toggle="tooltip" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-action @(user.IsActive ? "text-danger" : "text-success")" data-bs-toggle="tooltip" title="@(user.IsActive ? "Deactivate User" : "Activate User")">
                                                <i class="bi @(user.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="crm-empty-state">
                <div class="crm-empty-icon"><i class="bi bi-person-x"></i></div>
                <h5 class="crm-empty-title">No users found</h5>
                <p class="crm-empty-desc">No accounts matched your search criteria.</p>
            </div>
        }
    </div>
</div>
