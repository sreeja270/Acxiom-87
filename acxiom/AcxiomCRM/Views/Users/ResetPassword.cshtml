@model AcxiomCRM.ViewModels.UserResetPasswordViewModel

@{
    ViewData["Title"] = $"Reset Password - {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title text-warning"><i class="bi bi-key me-2"></i> Reset User Password</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                <div class="alert alert-warning small mb-4">
                    <i class="bi bi-shield-exclamation me-1"></i> As Administrator, you are setting a new password for user <strong>@Model.FullName</strong> (@Model.Email). This action is audited.
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold">New Temporary / Permanent Password <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" autofocus />
                        <small class="text-muted">Must satisfy standard policy (8+ chars, upper, lower, digit, special).</small>
                        <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check2-circle me-1"></i> Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
