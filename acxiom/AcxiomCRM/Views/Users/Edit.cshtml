@model AcxiomCRM.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = $"Edit User - {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pencil-square me-2 text-primary"></i> Edit User Profile & Role</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Email Address</label>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label small fw-semibold">Department</label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label small fw-semibold">Security Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" asp-items="Model.RolesList" class="form-select"></select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" />
                            <label class="form-check-label fw-semibold small" for="activeSwitch">Account Active</label>
                        </div>
                        <small class="text-muted">Inactive accounts are immediately blocked from signing in.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Update User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
