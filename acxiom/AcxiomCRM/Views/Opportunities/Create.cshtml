@model AcxiomCRM.ViewModels.OpportunityFormViewModel

@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-briefcase me-2 text-primary"></i> Create Pipeline Opportunity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Infrastructure Migration" autofocus />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer Account <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- Select Customer Account --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label small fw-semibold">Originating Lead (Optional)</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- None / Direct Deal --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label small fw-semibold">Deal Amount ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="50000.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Probability" class="form-label small fw-semibold">Win Probability (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stage" class="form-label small fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedToId" class="form-label small fw-semibold">Deal Owner</label>
                            <select asp-for="AssignedToId" asp-items="Model.UsersList" class="form-select">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label small fw-semibold">Deal Overview & Scope</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Commercial scope, products/services, milestones..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
