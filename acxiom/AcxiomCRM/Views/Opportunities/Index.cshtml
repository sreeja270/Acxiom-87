@model AcxiomCRM.ViewModels.OpportunityListViewModel

@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Opportunity Pipeline</h2>
        <p class="text-muted small mb-0">Track active commercial negotiations, stage progressions, and weighted revenue forecasts.</p>
    </div>
    <a asp-action="Create" class="btn btn-crm-primary">
        <i class="bi bi-briefcase me-1"></i> New Opportunity
    </a>
</div>

<!-- Pipeline Value Banners -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Total Active Pipeline</p>
                <h3 class="kpi-value text-primary">@Model.TotalPipelineValue.ToString("C0")</h3>
                <small class="text-muted">Unweighted cumulative deal values</small>
            </div>
            <div class="kpi-icon-box kpi-icon-primary"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Weighted Forecast Pipeline</p>
                <h3 class="kpi-value text-success">@Model.TotalWeightedPipelineValue.ToString("C0")</h3>
                <small class="text-success"><i class="bi bi-calculator me-1"></i> (Amount × Probability / 100)</small>
            </div>
            <div class="kpi-icon-box kpi-icon-success"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search opportunity or customer..." />
            </div>
        </div>

        <div class="col-md-3">
            <select name="stageFilter" class="form-select">
                <option value="">All Stages</option>
                <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-2">
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Deal Owners</option>
                </select>
            </div>
        }

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Opportunities Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Opportunities.Any())
        {
            <div class="table-responsive">
                <table class="table crm-table align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Opportunity Name</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Win Prob</th>
                            <th>Weighted Value</th>
                            <th>Close Date</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-bold font-monospace small text-muted">@o.OpportunityCode</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none text-primary">
                                        @o.OpportunityName
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId" class="text-decoration-none text-white small fw-medium">
                                        @(o.Customer?.CustomerName ?? "Account")
                                    </a>
                                </td>
                                <td class="fw-bold text-white">@o.Amount.ToString("C0")</td>
                                <td>
                                    @switch (o.Stage)
                                    {
                                        case "Won":
                                            <span class="badge badge-soft-success">Won</span>
                                            break;
                                        case "Lost":
                                            <span class="badge badge-soft-danger">Lost</span>
                                            break;
                                        case "Negotiation":
                                            <span class="badge badge-soft-warning">Negotiation</span>
                                            break;
                                        case "Proposal":
                                            <span class="badge badge-soft-info">Proposal</span>
                                            break;
                                        default:
                                            <span class="badge badge-soft-primary">Qualification</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 45px;">
                                            <div class="progress-bar @(o.Probability >= 70 ? "bg-success" : o.Probability >= 40 ? "bg-primary" : "bg-warning")" style="width: @(o.Probability)%"></div>
                                        </div>
                                        <span class="small fw-semibold">@o.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-success small">@o.WeightedPipeline.ToString("C0")</td>
                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                <td class="small">@(o.AssignedTo?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-action" data-bs-toggle="tooltip" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-action" data-bs-toggle="tooltip" title="Edit Deal">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-action" data-confirm="Are you sure you want to delete this opportunity?" data-bs-toggle="tooltip" title="Delete Deal">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.Opportunities.PageIndex</strong> of <strong>@Model.Opportunities.TotalPages</strong> (Total: @Model.Opportunities.TotalCount)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.Opportunities.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Opportunities.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Previous</a>
                        </li>
                        <li class="page-item @(!Model.Opportunities.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Opportunities.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="crm-empty-state">
                <div class="crm-empty-icon"><i class="bi bi-briefcase"></i></div>
                <h5 class="crm-empty-title">No opportunities found</h5>
                <p class="crm-empty-desc">No pipeline deals matched your filters or authorized scope.</p>
                <a asp-action="Create" class="btn btn-crm-primary">
                    <i class="bi bi-plus-lg me-1"></i> Create First Opportunity
                </a>
            </div>
        }
    </div>
</div>
