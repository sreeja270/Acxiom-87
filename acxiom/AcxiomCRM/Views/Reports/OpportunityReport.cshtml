@model AcxiomCRM.ViewModels.OpportunityReportViewModel

@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Opportunity Pipeline Report</h2>
        <p class="text-muted small mb-0">Stage distribution, face value amounts, win probability percentages, and projected close dates.</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-light border">
        <i class="bi bi-printer me-1"></i> Print Report
    </button>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="stage" class="form-select">
                <option value="">All Pipeline Stages</option>
                <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-3">
                <select name="ownerId" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Deal Owners</option>
                </select>
            </div>
        }

        <div class="col-md-2">
            <input type="date" name="start" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Created From" />
        </div>

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Apply</button>
            <a asp-action="OpportunityReport" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Pipeline Face Value</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.TotalAmount.ToString("C0")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Weighted Pipeline Forecast</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.TotalWeightedAmount.ToString("C0")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Closed Won Deals</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.WonCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Closed Lost Deals</span>
            <h4 class="fw-bold text-danger mb-0 mt-1">@Model.LostCount</h4>
        </div>
    </div>
</div>

<!-- Opportunities Report Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Opportunity Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Forecast</th>
                        <th>Target Close Date</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td class="font-monospace small">@o.OpportunityCode</td>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>@o.CustomerName</td>
                            <td><span class="badge badge-soft-primary">@o.Stage</span></td>
                            <td class="fw-bold text-white">@o.Amount.ToString("C0")</td>
                            <td>@o.Probability%</td>
                            <td class="fw-semibold text-success">@o.WeightedAmount.ToString("C0")</td>
                            <td class="small text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            <td class="small">@o.OwnerName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
