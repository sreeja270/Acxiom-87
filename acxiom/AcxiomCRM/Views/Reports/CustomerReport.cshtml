@model AcxiomCRM.ViewModels.CustomerReportViewModel

@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Customer Portfolio Report</h2>
        <p class="text-muted small mb-0">Overview of customer accounts, ownership allocation, and aggregated pipeline value.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCustomerReportCsv" asp-route-status="@Model.StatusFilter" asp-route-ownerId="@Model.AssignedToId" class="btn btn-sm btn-outline-success">
            <i class="bi bi-filetype-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-sm btn-light border">
            <i class="bi bi-printer me-1"></i> Print
        </button>
    </div>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="CustomerReport" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Active Only</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive Only</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-3">
                <select name="ownerId" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Account Owners</option>
                </select>
            </div>
        }

        <div class="col-md-2">
            <input type="date" name="start" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" title="From Date" />
        </div>

        <div class="col-md-2">
            <input type="date" name="end" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" title="To Date" />
        </div>

        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Apply</button>
            <a asp-action="CustomerReport" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Customers</span>
            <h4 class="fw-bold mb-0 mt-1">@Model.Items.Count</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Active Accounts</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.TotalActive</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Associated Pipeline Value</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.Items.Sum(c => c.TotalOpportunityValue).ToString("C0")</h4>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Created Date</th>
                        <th>Total Deals</th>
                        <th class="text-end">Deal Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="font-monospace small">@c.CustomerCode</td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "—")</td>
                            <td><span class="badge @(c.Status == "Active" ? "badge-soft-success" : "badge-soft-danger")">@c.Status</span></td>
                            <td>@c.OwnerName</td>
                            <td class="small text-muted">@c.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>@c.OpportunityCount</td>
                            <td class="text-end fw-bold text-white">@c.TotalOpportunityValue.ToString("C0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
