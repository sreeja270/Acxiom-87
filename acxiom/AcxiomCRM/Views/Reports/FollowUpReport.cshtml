@model AcxiomCRM.ViewModels.FollowUpReportViewModel

@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Follow-Up Compliance Report</h2>
        <p class="text-muted small mb-0">Audit scheduled customer interactions, overdue response times, and completed touchpoints.</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-light border">
        <i class="bi bi-printer me-1"></i> Print Report
    </button>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="FollowUpReport" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-3">
                <select name="ownerId" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Assignees</option>
                </select>
            </div>
        }

        <div class="col-md-3">
            <input type="date" name="start" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" title="From Date" />
        </div>

        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Apply</button>
            <a asp-action="FollowUpReport" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Recorded</span>
            <h4 class="fw-bold mb-0 mt-1">@Model.TotalCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Overdue Tasks</span>
            <h4 class="fw-bold text-danger mb-0 mt-1">@Model.OverdueCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Completed</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.CompletedCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Upcoming Planned</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.PlannedCount</h4>
        </div>
    </div>
</div>

<!-- Follow-Up Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Contact / Account</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        <th>Compliance State</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Items)
                    {
                        <tr>
                            <td class="small fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><span class="badge badge-soft-info">@f.FollowUpType</span></td>
                            <td class="fw-medium">@f.CustomerOrLeadName</td>
                            <td class="small">@f.Remarks</td>
                            <td><span class="badge @(f.Status == "Completed" ? "badge-soft-success" : f.Status == "Missed" ? "badge-soft-danger" : "badge-soft-primary")">@f.Status</span></td>
                            <td>
                                @if (f.IsOverdue)
                                {
                                    <span class="badge bg-danger">Overdue Attention Needed</span>
                                }
                                else if (f.Status == "Completed")
                                {
                                    <span class="badge bg-success">On-time Completion</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-white border">Scheduled</span>
                                }
                            </td>
                            <td class="small">@f.OwnerName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
