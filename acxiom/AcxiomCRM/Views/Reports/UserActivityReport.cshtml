@model AcxiomCRM.ViewModels.UserActivityReportViewModel

@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">User Sales Activity Report</h2>
        <p class="text-muted small mb-0">Productivity tracking across team members, interaction volumes, and task follow-through.</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-light border">
        <i class="bi bi-printer me-1"></i> Print Report
    </button>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="UserActivityReport" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="date" name="start" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Activity From" />
        </div>

        <div class="col-md-4">
            <input type="date" name="end" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Activity To" />
        </div>

        <div class="col-md-4 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
            <a asp-action="UserActivityReport" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- User Activity Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Team Member</th>
                        <th>Department</th>
                        <th>Total Activities</th>
                        <th>Phone Calls</th>
                        <th>Meetings Held</th>
                        <th>Emails Sent</th>
                        <th>Tasks Handled</th>
                        <th class="text-end">Completed Follow-Ups</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.UserSummaries)
                    {
                        <tr>
                            <td class="fw-bold">
                                <i class="bi bi-person-circle me-1 text-primary"></i> @u.UserName
                            </td>
                            <td class="small text-muted">@u.Role</td>
                            <td class="fw-bold text-primary">@u.TotalActivities</td>
                            <td><span class="badge badge-soft-info">@u.CallsCount calls</span></td>
                            <td><span class="badge badge-soft-primary">@u.MeetingsCount mtgs</span></td>
                            <td><span class="badge badge-soft-secondary">@u.EmailsCount emails</span></td>
                            <td><span class="badge badge-soft-warning">@u.TasksCount tasks</span></td>
                            <td class="text-end fw-bold text-success">@u.CompletedFollowUps</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
