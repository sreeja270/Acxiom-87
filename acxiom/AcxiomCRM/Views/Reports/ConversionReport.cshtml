@model AcxiomCRM.ViewModels.ConversionReportViewModel

@{
    ViewData["Title"] = "Conversion & Win Rate Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Lead Conversion & Opportunity Win Rate</h2>
        <p class="text-muted small mb-0">Sales funnel efficiency analysis, prospect conversion percentages, and deal win rates.</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-light border">
        <i class="bi bi-printer me-1"></i> Print Report
    </button>
</div>

<!-- Funnel Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Inquiries / Leads</span>
            <h3 class="fw-bold mb-0 mt-1">@Model.TotalLeads</h3>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Successfully Converted</span>
            <h3 class="fw-bold text-success mb-0 mt-1">@Model.ConvertedLeads</h3>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Lead Conversion Rate</span>
            <h3 class="fw-bold text-primary mb-0 mt-1">@Model.ConversionRatePercentage%</h3>
            <small class="text-muted">(Converted / Total)</small>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Opportunity Win Rate</span>
            <h3 class="fw-bold text-info mb-0 mt-1">@Model.OpportunityWinRatePercentage%</h3>
            <small class="text-muted">Closed Won / All Closed</small>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Closed Won Contract Revenue</p>
                <h3 class="kpi-value text-success">@Model.TotalWonRevenue.ToString("C0")</h3>
                <small class="text-success"><i class="bi bi-trophy me-1"></i> Net Realized Sales</small>
            </div>
            <div class="kpi-icon-box kpi-icon-success"><i class="bi bi-cash-coin"></i></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Closed Lost Deal Value</p>
                <h3 class="kpi-value text-danger">@Model.TotalLostRevenue.ToString("C0")</h3>
                <small class="text-danger"><i class="bi bi-x-circle me-1"></i> Dropped Deals</small>
            </div>
            <div class="kpi-icon-box kpi-icon-danger"><i class="bi bi-archive"></i></div>
        </div>
    </div>
</div>

<!-- Source Breakdown Table -->
<div class="crm-card">
    <div class="crm-card-header">
        <h5 class="crm-card-title"><i class="bi bi-funnel-fill me-2 text-primary"></i> Conversion Effectiveness by Marketing Source</h5>
    </div>
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Lead Acquisition Channel</th>
                        <th>Total Leads Ingested</th>
                        <th>Converted to Customers</th>
                        <th>Conversion Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.BySource)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Source</td>
                            <td>@s.Total</td>
                            <td class="fw-bold text-success">@s.Converted</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar bg-success" style="width: @(s.RatePercentage)%"></div>
                                    </div>
                                    <span class="small fw-semibold">@s.RatePercentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
