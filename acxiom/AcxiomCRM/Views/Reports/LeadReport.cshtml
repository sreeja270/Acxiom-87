@model AcxiomCRM.ViewModels.LeadReportViewModel

@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Lead Acquisition & Quality Report</h2>
        <p class="text-muted small mb-0">Analysis of lead intake channels, qualification rates, and converted revenue.</p>
    </div>
    <button onclick="window.print()" class="btn btn-sm btn-light border">
        <i class="bi bi-printer me-1"></i> Print Report
    </button>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="LeadReport" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="source" class="form-select">
                <option value="">All Sources</option>
                <option value="Website" selected="@(Model.SourceFilter == "Website")">Website</option>
                <option value="Referral" selected="@(Model.SourceFilter == "Referral")">Referral</option>
                <option value="Cold Call" selected="@(Model.SourceFilter == "Cold Call")">Cold Call</option>
                <option value="Event" selected="@(Model.SourceFilter == "Event")">Event</option>
                <option value="Partner" selected="@(Model.SourceFilter == "Partner")">Partner</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-3">
                <select name="ownerId" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Owners</option>
                </select>
            </div>
        }

        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-funnel me-1"></i> Apply</button>
            <a asp-action="LeadReport" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Leads Captured</span>
            <h4 class="fw-bold mb-0 mt-1">@Model.TotalLeads</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Converted to Accounts</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.ConvertedCount</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card text-center p-3">
            <span class="text-muted small">Total Pipeline Potential</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.TotalExpectedValue.ToString("C0")</h4>
        </div>
    </div>
</div>

<!-- Leads Report Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="table crm-table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Owner</th>
                        <th>Created</th>
                        <th>Conversion Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td class="font-monospace small">@l.LeadCode</td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "—")</td>
                            <td><span class="badge badge-soft-secondary">@l.Source</span></td>
                            <td><span class="badge badge-soft-primary">@l.Status</span></td>
                            <td class="fw-bold">@l.ExpectedValue.ToString("C0")</td>
                            <td>@l.OwnerName</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (l.IsConverted)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> Converted @l.ConvertedDate?.ToString("MM/dd")</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">In Qualification</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
