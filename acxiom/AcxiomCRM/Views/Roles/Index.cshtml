@model AcxiomCRM.ViewModels.RoleListViewModel

@{
    ViewData["Title"] = "Security Roles & Permissions";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1 text-white">Security Roles & Access Control</h2>
    <p class="text-muted small mb-0">Role definitions, authorization privileges, and data scope isolation policies.</p>
</div>

<div class="row g-4">
    @foreach (var role in Model.Roles)
    {
        <div class="col-lg-4">
            <div class="crm-card h-100 d-flex flex-column">
                <div class="crm-card-header">
                    <div>
                        <h5 class="crm-card-title fw-bold text-white">@role.Name</h5>
                        <span class="text-muted small">@role.UserCount Assigned Active User(s)</span>
                    </div>
                    <span class="badge @(role.Name == "Admin" ? "bg-danger" : role.Name == "Manager" ? "bg-warning text-white" : "bg-primary") badge-role">
                        @role.Name
                    </span>
                </div>
                <div class="crm-card-body flex-grow-1">
                    <p class="small text-muted mb-4">@role.Description</p>

                    <h6 class="fw-bold small text-white mb-3"><i class="bi bi-shield-check text-success me-1"></i> Authorized Permissions</h6>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var perm in role.Permissions)
                        {
                            <li class="mb-2 d-flex align-items-center">
                                <i class="bi bi-check2 text-success me-2 fw-bold"></i>
                                <span>@perm</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="p-3 border-top bg-light rounded-bottom text-end">
                    <a asp-controller="Users" asp-action="Index" asp-route-roleFilter="@role.Name" class="btn btn-sm btn-outline-secondary">
                        View Users in @role.Name <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
