@model AcxiomCRM.ViewModels.AuditLogListViewModel

@{
    ViewData["Title"] = "Security Audit Logs";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Immutable Audit Log</h2>
        <p class="text-muted small mb-0">Append-only compliance audit trail of all authentication events, user updates, and CRM state modifications.</p>
    </div>
    <a asp-controller="Reports" asp-action="AuditReport" class="btn btn-crm-secondary">
        <i class="bi bi-file-earmark-bar-graph me-1"></i> Audit Compliance Report
    </a>
</div>

<!-- Filters Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search actor, action, details..." />
            </div>
        </div>

        <div class="col-md-2">
            <select name="actionFilter" asp-items="Model.ActionsList" class="form-select">
                <option value="">All Actions</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="entityFilter" asp-items="Model.EntitiesList" class="form-select">
                <option value="">All Entities</option>
            </select>
        </div>

        <div class="col-md-2">
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Start Date" />
        </div>

        <div class="col-md-2">
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" title="End Date" />
        </div>

        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary" title="Filter"><i class="bi bi-funnel"></i></button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Audit Log Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.AuditLogs.Any())
        {
            <div class="table-responsive">
                <table class="table crm-table align-middle">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Actor / Email</th>
                            <th>Action</th>
                            <th>Entity Module</th>
                            <th>Record ID</th>
                            <th>IP Address</th>
                            <th>Audit Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.AuditLogs)
                        {
                            <tr>
                                <td class="font-monospace small text-nowrap text-muted">
                                    @log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td class="small fw-semibold">
                                    @(log.UserEmail ?? "System / Anonymous")
                                </td>
                                <td>
                                    <span class="badge @(log.Action == "Login" ? "badge-soft-success" : log.Action.Contains("Failed") || log.Action == "Lockout" ? "badge-soft-danger" : log.Action == "Create" ? "badge-soft-primary" : log.Action == "Delete" ? "badge-soft-danger" : "badge-soft-warning")">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-white border">@log.EntityName</span></td>
                                <td class="small font-monospace">@(log.RecordId ?? "—")</td>
                                <td class="small font-monospace text-muted">@(log.IpAddress ?? "127.0.0.1")</td>
                                <td class="small">
                                    <div>@(log.Details ?? "—")</div>
                                    @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                            @if (!string.IsNullOrEmpty(log.OldValue))
                                            {
                                                <div><span class="text-danger">Old:</span> @log.OldValue</div>
                                            }
                                            @if (!string.IsNullOrEmpty(log.NewValue))
                                            {
                                                <div><span class="text-success">New:</span> @log.NewValue</div>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.AuditLogs.PageIndex</strong> of <strong>@Model.AuditLogs.TotalPages</strong> (Total: @Model.AuditLogs.TotalCount)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.AuditLogs.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.AuditLogs.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                        </li>
                        <li class="page-item @(!Model.AuditLogs.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.AuditLogs.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="crm-empty-state">
                <div class="crm-empty-icon"><i class="bi bi-journal-text"></i></div>
                <h5 class="crm-empty-title">No audit records found</h5>
                <p class="crm-empty-desc">No events matched your search filter parameters.</p>
            </div>
        }
    </div>
</div>
