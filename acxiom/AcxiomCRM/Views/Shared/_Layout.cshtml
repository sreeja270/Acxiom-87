@using AcxiomCRM.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = SignInManager.IsSignedIn(User);
    ApplicationUser? currentUser = null;
    string userRole = "Sales Executive";
    if (isAuthenticated)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (User.IsInRole(DbInitializer.AdminRole))
        {
            userRole = DbInitializer.AdminRole;
        }
        else if (User.IsInRole(DbInitializer.ManagerRole))
        {
            userRole = DbInitializer.ManagerRole;
        }
        else
        {
            userRole = DbInitializer.SalesExecutiveRole;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Enterprise CRM") - AcxiomCRM</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Enterprise Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="crm-wrapper">
            <!-- Sidebar -->
            <aside class="crm-sidebar">
                <div class="crm-sidebar-header">
                    <div class="crm-logo-badge">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h1 class="crm-brand-title">AcxiomCRM</h1>
                        <p class="crm-brand-subtitle">Enterprise Suite</p>
                    </div>
                </div>

                <div class="crm-sidebar-menu">
                    <!-- Core -->
                    <div class="crm-menu-header">Overview</div>
                    <a class="crm-nav-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>

                    <!-- CRM Workflows -->
                    <div class="crm-menu-header">CRM Lifecycle</div>
                    <a class="crm-nav-link @(currentController == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                        <i class="bi bi-funnel"></i>
                        <span>Leads</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Opportunities</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                        <i class="bi bi-calendar2-check"></i>
                        <span>Follow-Ups</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                        <i class="bi bi-clock-history"></i>
                        <span>Activities</span>
                    </a>

                    <!-- Reports -->
                    <div class="crm-menu-header">Analytics & Reports</div>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "CustomerReport" ? "active" : "")" asp-controller="Reports" asp-action="CustomerReport">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>Customer Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "LeadReport" ? "active" : "")" asp-controller="Reports" asp-action="LeadReport">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>Lead Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "FollowUpReport" ? "active" : "")" asp-controller="Reports" asp-action="FollowUpReport">
                        <i class="bi bi-calendar-event"></i>
                        <span>Follow-Up Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "OpportunityReport" ? "active" : "")" asp-controller="Reports" asp-action="OpportunityReport">
                        <i class="bi bi-cash-stack"></i>
                        <span>Opportunity Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "PipelineReport" ? "active" : "")" asp-controller="Reports" asp-action="PipelineReport">
                        <i class="bi bi-diagram-3"></i>
                        <span>Pipeline Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "ConversionReport" ? "active" : "")" asp-controller="Reports" asp-action="ConversionReport">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Conversion Report</span>
                    </a>
                    <a class="crm-nav-link @(currentController == "Reports" && currentAction == "UserActivityReport" ? "active" : "")" asp-controller="Reports" asp-action="UserActivityReport">
                        <i class="bi bi-activity"></i>
                        <span>Activity Report</span>
                    </a>

                    <!-- Administration (Admin Only) -->
                    @if (User.IsInRole(DbInitializer.AdminRole))
                    {
                        <div class="crm-menu-header">Administration</div>
                        <a class="crm-nav-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Users</span>
                        </a>
                        <a class="crm-nav-link @(currentController == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-shield-lock"></i>
                            <span>Roles</span>
                        </a>
                        <a class="crm-nav-link @(currentController == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-journal-text"></i>
                            <span>Audit Logs</span>
                        </a>
                        <a class="crm-nav-link @(currentController == "Reports" && currentAction == "AuditReport" ? "active" : "")" asp-controller="Reports" asp-action="AuditReport">
                            <i class="bi bi-shield-shaded"></i>
                            <span>Audit Report</span>
                        </a>
                    }
                </div>

                <!-- Footer User Chip -->
                <div class="crm-sidebar-footer">
                    <div class="crm-user-chip">
                        <div class="crm-user-avatar">
                            @(currentUser?.FullName.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                        <div class="text-truncate" style="max-width: 150px;">
                            <div class="text-white fw-semibold small text-truncate">@(currentUser?.FullName ?? "User")</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@userRole</div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace -->
            <div class="crm-main">
                <!-- Topbar -->
                <header class="crm-topbar">
                    <div class="crm-topbar-left">
                        <button class="btn btn-sm btn-crm-secondary d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb crm-breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">AcxiomCRM</a></li>
                                <li class="breadcrumb-item active fw-medium" aria-current="page">@(ViewData["Title"] ?? currentController)</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="crm-topbar-right">
                        <!-- Role Badge with Neon Glow -->
                        <span class="badge badge-role @(userRole == DbInitializer.AdminRole ? "badge-soft-danger" : userRole == DbInitializer.ManagerRole ? "badge-soft-warning" : "badge-soft-primary")">
                            <i class="bi bi-shield-fill-check me-1"></i> @userRole
                        </span>

                        <!-- REST API Docs Link -->
                        <a href="/swagger" target="_blank" class="btn btn-sm btn-crm-secondary" data-bs-toggle="tooltip" title="Interactive REST API Documentation">
                            <i class="bi bi-code-slash me-1 text-info"></i> API Docs
                        </a>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-crm-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-size: 0.85rem; font-weight: 700; background: linear-gradient(135deg, #7c3aed, #06b6d4); color: #fff; box-shadow: 0 0 10px rgba(124, 58, 237, 0.5);">
                                    @(currentUser?.FullName.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </div>
                                <span class="d-none d-md-inline small fw-semibold">@(currentUser?.FullName ?? "Account")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="dropdown-header">
                                    <div class="fw-bold">@(currentUser?.FullName)</div>
                                    <div class="text-muted small text-truncate">@(currentUser?.Email)</div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2 text-primary"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-warning"></i> Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content Area -->
                <main class="crm-content">
                    <!-- Global Notifications -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Public Layout (Login/Register/Errors) -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
