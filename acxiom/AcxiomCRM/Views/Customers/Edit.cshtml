@model AcxiomCRM.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = $"Edit Customer - {Model.CustomerName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pencil-square me-2 text-primary"></i> Edit Customer Account</h5>
                <span class="badge bg-light text-white font-monospace">@Model.CustomerCode</span>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CustomerCode" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerName" class="form-label small fw-semibold">Customer / Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" autofocus />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label small fw-semibold">Company / Organization</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold">Street Address</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label small fw-semibold">City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="State" class="form-label small fw-semibold">State / Region</label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Status" class="form-label small fw-semibold">Account Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
                        {
                            <div class="col-md-6 mb-4">
                                <label asp-for="AssignedToId" class="form-label small fw-semibold">Assigned Sales Executive</label>
                                <select asp-for="AssignedToId" asp-items="Model.UsersList" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                                <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Update Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
