@model AcxiomCRM.ViewModels.CustomerDetailsViewModel

@{
    ViewData["Title"] = $"Customer - {Model.Customer.CustomerName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-light border"><i class="bi bi-arrow-left"></i></a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0 text-white">@Model.Customer.CustomerName</h2>
                <span class="badge @(Model.Customer.Status == "Active" ? "badge-soft-success" : "badge-soft-danger")">@Model.Customer.Status</span>
            </div>
            <p class="text-muted small mb-0 font-monospace">@Model.Customer.CustomerCode • @(Model.Customer.CompanyName ?? "Independent Account")</p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-crm-primary">
            <i class="bi bi-briefcase me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-sm btn-light border">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer Profile Card -->
    <div class="col-lg-4">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-person-lines-fill me-2 text-primary"></i> Contact Details</h5>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small">Company</label>
                    <div class="fw-semibold">@(Model.Customer.CompanyName ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Email Address</label>
                    <div><a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Phone</label>
                    <div><a href="tel:@Model.Customer.Phone" class="text-decoration-none">@Model.Customer.Phone</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Billing / Shipping Address</label>
                    <div class="small">
                        @if (!string.IsNullOrEmpty(Model.Customer.Address))
                        {
                            <div>@Model.Customer.Address</div>
                            <div>@Model.Customer.City, @Model.Customer.State</div>
                        }
                        else
                        {
                            <span class="text-muted">Not specified</span>
                        }
                    </div>
                </div>
                <hr />
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Account Owner:</span>
                    <strong class="small">@(Model.Customer.AssignedTo?.FullName ?? "Unassigned")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Customer Since:</span>
                    <span class="small">@Model.Customer.CreatedDate.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-cash-coin me-2 text-success"></i> Revenue Metrics</h5>
            </div>
            <div class="crm-card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small">Total Pipeline:</span>
                    <h5 class="fw-bold text-primary mb-0">@Model.TotalOpportunityValue.ToString("C0")</h5>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Won Contract Value:</span>
                    <h5 class="fw-bold text-success mb-0">@Model.TotalWonValue.ToString("C0")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Related Records Tabs -->
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <ul class="nav nav-pills card-header-pills" id="customerTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active btn-sm" id="opps-tab" data-bs-toggle="pill" data-bs-target="#opps" type="button" role="tab">
                            Opportunities (@Model.RelatedOpportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link btn-sm" id="followups-tab" data-bs-toggle="pill" data-bs-target="#followups" type="button" role="tab">
                            Follow-Ups (@Model.RelatedFollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link btn-sm" id="activities-tab" data-bs-toggle="pill" data-bs-target="#activities" type="button" role="tab">
                            Activity Timeline (@Model.RelatedActivities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link btn-sm" id="audit-tab" data-bs-toggle="pill" data-bs-target="#audit" type="button" role="tab">
                            Audit History (@Model.AuditHistory.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="crm-card-body p-0">
                <div class="tab-content" id="customerTabContent">
                    <!-- Opportunities Tab -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        @if (Model.RelatedOpportunities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table crm-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Deal Code</th>
                                            <th>Name</th>
                                            <th>Amount</th>
                                            <th>Stage</th>
                                            <th>Probability</th>
                                            <th>Expected Close</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in Model.RelatedOpportunities)
                                        {
                                            <tr>
                                                <td class="font-monospace small">@o.OpportunityCode</td>
                                                <td>
                                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none">
                                                        @o.OpportunityName
                                                    </a>
                                                </td>
                                                <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                                <td><span class="badge badge-soft-primary">@o.Stage</span></td>
                                                <td>@o.Probability%</td>
                                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="crm-empty-state py-4">
                                <p class="text-muted small mb-0">No opportunities linked with this customer.</p>
                            </div>
                        }
                    </div>

                    <!-- Follow-Ups Tab -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        @if (Model.RelatedFollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table crm-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Remarks</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.RelatedFollowUps)
                                        {
                                            <tr>
                                                <td class="small fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")</td>
                                                <td><span class="badge badge-soft-info">@f.FollowUpType</span></td>
                                                <td class="small">@f.Remarks</td>
                                                <td><span class="badge @(f.Status == "Completed" ? "badge-soft-success" : f.Status == "Missed" ? "badge-soft-danger" : "badge-soft-primary")">@f.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="crm-empty-state py-4">
                                <p class="text-muted small mb-0">No follow-ups recorded.</p>
                            </div>
                        }
                    </div>

                    <!-- Activities Tab -->
                    <div class="tab-pane fade p-3" id="activities" role="tabpanel">
                        @if (Model.RelatedActivities.Any())
                        {
                            <div class="crm-timeline">
                                @foreach (var a in Model.RelatedActivities)
                                {
                                    <div class="crm-timeline-item">
                                        <div class="crm-timeline-marker"></div>
                                        <div class="card p-3 border shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge badge-soft-primary">@a.ActivityType</span>
                                                <small class="text-muted">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</small>
                                            </div>
                                            <h6 class="fw-bold mb-1">@a.Subject</h6>
                                            <p class="text-muted small mb-0">@a.Description</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="crm-empty-state py-4">
                                <p class="text-muted small mb-0">No interaction activities logged.</p>
                            </div>
                        }
                    </div>

                    <!-- Audit Tab -->
                    <div class="tab-pane fade" id="audit" role="tabpanel">
                        @if (Model.AuditHistory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table crm-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Action</th>
                                            <th>Details</th>
                                            <th>By</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in Model.AuditHistory)
                                        {
                                            <tr>
                                                <td class="small text-muted font-monospace">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td><span class="badge bg-light text-white border">@log.Action</span></td>
                                                <td class="small">@(log.Details ?? log.NewValue)</td>
                                                <td class="small">@(log.UserEmail ?? "System")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="crm-empty-state py-4">
                                <p class="text-muted small mb-0">No audit entries recorded for this customer.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
