@model AcxiomCRM.ViewModels.LeadFormViewModel

@{
    ViewData["Title"] = "Capture New Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-funnel me-2 text-primary"></i> Capture Prospect Lead</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadName" class="form-label small fw-semibold">Lead Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="e.g. Jonathan Drake" autofocus />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label small fw-semibold">Company / Business</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Nexa Robotics Inc" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="jdrake@nexarobotics.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+1-555-0201" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Source" class="form-label small fw-semibold">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Event">Event</option>
                                <option value="Partner">Partner</option>
                                <option value="Social Media">Social Media</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label small fw-semibold">Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Deal Value ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ExpectedValue" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
                        {
                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedToId" class="form-label small fw-semibold">Assigned Sales Executive</label>
                                <select asp-for="AssignedToId" asp-items="Model.UsersList" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label small fw-semibold">Discovery Notes & Background</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key interests, customer pain points, budget authority..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
