@model AcxiomCRM.ViewModels.FollowUpListViewModel

@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white">Client Follow-Ups</h2>
        <p class="text-muted small mb-0">Schedule and monitor relationship follow-ups, calls, and commitments.</p>
    </div>
    <a asp-action="Create" class="btn btn-crm-primary">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Counters Bar -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Overdue Follow-Ups</p>
                <h3 class="kpi-value text-danger">@Model.OverdueCount</h3>
                <small class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> Requires Immediate Attention</small>
            </div>
            <div class="kpi-icon-box kpi-icon-danger"><i class="bi bi-alarm-fill"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Due Today</p>
                <h3 class="kpi-value text-warning">@Model.TodayCount</h3>
                <small class="text-muted">Scheduled for completion today</small>
            </div>
            <div class="kpi-icon-box kpi-icon-warning"><i class="bi bi-calendar-event-fill"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card d-flex align-items-center justify-content-between">
            <div>
                <p class="kpi-title">Upcoming Planned</p>
                <h3 class="kpi-value text-primary">@Model.UpcomingCount</h3>
                <small class="text-muted">Next 7 days schedule</small>
            </div>
            <div class="kpi-icon-box kpi-icon-primary"><i class="bi bi-calendar2-check-fill"></i></div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="crm-filter-bar mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search remarks or contact..." />
            </div>
        </div>

        <div class="col-md-2">
            <select name="dateFilter" class="form-select">
                <option value="">All Timeframes</option>
                <option value="Today" selected="@(Model.DateFilter == "Today")">Due Today</option>
                <option value="Upcoming" selected="@(Model.DateFilter == "Upcoming")">Upcoming</option>
                <option value="Overdue" selected="@(Model.DateFilter == "Overdue")">Overdue</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="typeFilter" class="form-select">
                <option value="">All Types</option>
                <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                <option value="Demo" selected="@(Model.TypeFilter == "Demo")">Demo</option>
                <option value="Check-in" selected="@(Model.TypeFilter == "Check-in")">Check-in</option>
            </select>
        </div>

        @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
        {
            <div class="col-md-2">
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select">
                    <option value="">All Owners</option>
                </select>
            </div>
        }

        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-crm-primary" title="Filter"><i class="bi bi-funnel"></i></button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<!-- Follow-Ups Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.FollowUps.Any())
        {
            <div class="table-responsive">
                <table class="table crm-table align-middle">
                    <thead>
                        <tr>
                            <th>Due Date & Time</th>
                            <th>Type</th>
                            <th>Contact / Account</th>
                            <th>Action Remarks</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th class="text-end">Quick Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td class="fw-semibold small text-nowrap">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                    @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-soft-info">@f.FollowUpType</span>
                                </td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-medium text-decoration-none">
                                            <i class="bi bi-person me-1"></i>@f.Customer.CustomerName
                                        </a>
                                    }
                                    else if (f.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="fw-medium text-decoration-none">
                                            <i class="bi bi-funnel me-1"></i>@f.Lead.LeadName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">General Account</span>
                                    }
                                </td>
                                <td>
                                    <div>@f.Remarks</div>
                                    @if (!string.IsNullOrEmpty(f.CompletionNotes))
                                    {
                                        <div class="small text-muted mt-1"><em>Notes: @f.CompletionNotes</em></div>
                                    }
                                </td>
                                <td>
                                    @switch (f.Status)
                                    {
                                        case "Completed":
                                            <span class="badge badge-soft-success">Completed</span>
                                            break;
                                        case "Missed":
                                            <span class="badge badge-soft-danger">Missed</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge badge-soft-secondary">Cancelled</span>
                                            break;
                                        default:
                                            <span class="badge badge-soft-primary">Planned</span>
                                            break;
                                    }
                                </td>
                                <td class="small">@(f.AssignedTo?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (f.Status == "Planned")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@f.FollowUpId" />
                                                <input type="hidden" name="newStatus" value="Completed" />
                                                <button type="submit" class="btn btn-action text-success" data-bs-toggle="tooltip" title="Mark Completed">
                                                    <i class="bi bi-check2-circle fs-6"></i>
                                                </button>
                                            </form>
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@f.FollowUpId" />
                                                <input type="hidden" name="newStatus" value="Missed" />
                                                <button type="submit" class="btn btn-action text-danger" data-bs-toggle="tooltip" title="Mark Missed">
                                                    <i class="bi bi-x-circle fs-6"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-action" data-bs-toggle="tooltip" title="Edit/Reschedule">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-action" data-confirm="Are you sure you want to delete this follow-up?" data-bs-toggle="tooltip" title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <span class="text-muted small">
                    Showing page <strong>@Model.FollowUps.PageIndex</strong> of <strong>@Model.FollowUps.TotalPages</strong> (Total: @Model.FollowUps.TotalCount)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.FollowUps.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.FollowUps.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                        </li>
                        <li class="page-item @(!Model.FollowUps.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.FollowUps.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="crm-empty-state">
                <div class="crm-empty-icon"><i class="bi bi-calendar2-check"></i></div>
                <h5 class="crm-empty-title">No follow-ups found</h5>
                <p class="crm-empty-desc">No follow-up tasks match your selected timeframe or scope.</p>
                <a asp-action="Create" class="btn btn-crm-primary">
                    <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
                </a>
            </div>
        }
    </div>
</div>
