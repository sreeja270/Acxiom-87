@model AcxiomCRM.ViewModels.FollowUpFormViewModel

@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-calendar-plus me-2 text-primary"></i> Schedule Follow-Up Interaction</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer Account (Optional)</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- No Customer Linked --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label small fw-semibold">Prospect Lead (Optional)</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- No Lead Linked --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" type="datetime-local" class="form-control" />
                            <small class="text-muted">Must be today or in the future.</small>
                            <span asp-validation-for="FollowUpDate" class="text-danger small d-block"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold">Activity Medium <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting (In-person / Virtual)</option>
                                <option value="Email">Email Communication</option>
                                <option value="Demo">Product Demo</option>
                                <option value="Check-in">General Check-in</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label small fw-semibold">Objective & Action Remarks <span class="text-danger">*</span></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Specify follow-up agenda, key topics to discuss, or required materials..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
                    {
                        <div class="mb-4">
                            <label asp-for="AssignedToId" class="form-label small fw-semibold">Assignee</label>
                            <select asp-for="AssignedToId" asp-items="Model.UsersList" class="form-select">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-calendar-check me-1"></i> Schedule Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
