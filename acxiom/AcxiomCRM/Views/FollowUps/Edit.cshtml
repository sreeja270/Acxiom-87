@model AcxiomCRM.ViewModels.FollowUpFormViewModel

@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pencil-square me-2 text-primary"></i> Edit / Reschedule Follow-Up</h5>
                <span class="badge @(Model.Status == "Completed" ? "bg-success" : "bg-primary")">@Model.Status</span>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer Account</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label small fw-semibold">Prospect Lead</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold">Activity Medium <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Demo">Product Demo</option>
                                <option value="Check-in">Check-in</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label small fw-semibold">Remarks & Goal <span class="text-danger">*</span></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompletionNotes" class="form-label small fw-semibold">Outcome / Completion Notes</label>
                        <textarea asp-for="CompletionNotes" class="form-control" rows="2" placeholder="Record results if completed or reasons if missed/cancelled..."></textarea>
                        <span asp-validation-for="CompletionNotes" class="text-danger small"></span>
                    </div>

                    @if (!User.IsInRole(AcxiomCRM.Data.DbInitializer.SalesExecutiveRole))
                    {
                        <div class="mb-4">
                            <label asp-for="AssignedToId" class="form-label small fw-semibold">Assignee</label>
                            <select asp-for="AssignedToId" asp-items="Model.UsersList" class="form-select"></select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-crm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Update Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
