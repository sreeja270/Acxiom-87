@model AcxiomCRM.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register Team Member";
    Layout = "_Layout";
}

<div class="auth-page-container">
    <div class="auth-card" style="max-width: 520px;">
        <div class="text-center mb-4">
            <div class="auth-badge-glow">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h2 class="fw-bold text-white mb-1" style="letter-spacing: -0.5px;">Create CRM Account</h2>
            <p class="text-muted small mb-0">Join your enterprise sales & customer relationship team</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0 shadow-sm" role="alert"></div>

            <div class="mb-3 auth-input-group">
                <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" autofocus />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3 auth-input-group">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Work Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3 auth-input-group">
                    <label asp-for="Department" class="form-label small fw-semibold text-secondary">Department</label>
                    <input asp-for="Department" class="form-control" placeholder="e.g. Enterprise Sales" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3 auth-input-group">
                    <label asp-for="Role" class="form-label small fw-semibold text-secondary">Assigned Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Sales Executive">Sales Executive</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Administrator</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3 auth-input-group">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password <small class="text-muted">(Min 8 chars, mixed case, number, symbol)</small></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key text-muted"></i></span>
                    <input asp-for="Password" id="regPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 auth-input-group">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shield-lock text-muted"></i></span>
                    <input asp-for="ConfirmPassword" id="regConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-crm-primary w-100 py-2 fs-6 mb-3">
                <i class="bi bi-check2-circle me-1"></i> Register Account
            </button>
        </form>

        <div class="text-center mt-2">
            <span class="text-muted small">Already have credentials? </span>
            <a asp-action="Login" class="text-decoration-none fw-semibold small text-primary">Return to Sign In</a>
        </div>
    </div>

    <!-- Security Trust Badges Footer -->
    <div class="auth-trust-badges">
        <span><i class="bi bi-lock-fill text-success"></i> 256-Bit SSL Encrypted</span>
        <span><i class="bi bi-shield-check text-info"></i> Role-Based Scoping</span>
        <span><i class="bi bi-cpu-fill text-primary"></i> ASP.NET Core Identity</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
