@{
    ViewData["Title"] = "Access Forbidden";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="crm-card p-5">
            <div class="text-danger mb-3" style="font-size: 4rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h2 class="fw-bold text-white mb-2">403 - Access Forbidden</h2>
            <p class="text-muted mb-4">
                You do not have the required role permissions or resource authorization scope to access this CRM area or record.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-crm-primary">
                    <i class="bi bi-house me-1"></i> Return to Dashboard
                </a>
                <a href="javascript:history.back()" class="btn btn-crm-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
